# Application (native host processes; never bind publicly)
APP_NAME=Verifact AI
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO
# PostgreSQL (Compose consumes POSTGRES_*; Python consumes DATABASE_URL)
POSTGRES_DB=verifact
POSTGRES_USER=verifact
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql+psycopg://verifact:replace-with-random-local-password@localhost:5432/verifact
# Redis / Celery (loopback-only, no authentication)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=1
# Storage (MiB; 0 media size means disk budget is the limiting safeguard)
STORAGE_BACKEND=minio
LOCAL_STORAGE_PATH=./data/storage
STORAGE_BUDGET_MB=10240
MIN_FREE_DISK_MB=1024
MINIO_IMAGE=verifact-minio:source-20250907
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=verifact-local
MINIO_SECRET_KEY=replace-with-random-minio-password
MINIO_BUCKET=verifact-media
MINIO_USE_SSL=false
# Ollama in Docker; concurrency, residency and cloud access are controlled by Compose
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=qwen3:1.7b
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_CONCURRENT_REQUESTS=1
# Whisper; portable provider uses model names small/base instead of MLX repositories
WHISPER_PROVIDER=mlx
WHISPER_MODEL=mlx-community/whisper-small-mlx
WHISPER_FALLBACK_MODEL=mlx-community/whisper-base-mlx
WHISPER_LANGUAGE=pt
WHISPER_CHUNK_SECONDS=180
WHISPER_CHUNK_OVERLAP_SECONDS=5
WHISPER_CONCURRENCY=1
# Diarization: accept Community-1 terms and supply your own read token.
# Explicitly set false for degraded processing without speaker attribution.
DIARIZATION_ENABLED=true
DIARIZATION_PROVIDER=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_CONCURRENCY=1
HUGGINGFACE_TOKEN=
# CrewAI and bounded reasoning
CREWAI_SEQUENTIAL_EXECUTION=true
CREWAI_MAX_PARALLEL_AGENTS=1
MAX_LLM_CALLS=200
LLM_OUTPUT_TOKENS=768
MAX_CLAIMS_PER_BATCH=5
MAX_RETRIES=2
STAGE_TIMEOUT=900
# Research; SEARXNG_SECRET_KEY is consumed by Compose
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_SECRET_KEY=replace-with-random-local-key
SEARCH_ENGINE=duckduckgo
SEARCH_LANGUAGE=pt-BR
SEARCH_MAX_RESULTS=3
SEARCH_MAX_CONCURRENT_REQUESTS=2
SEARCH_REQUEST_TIMEOUT=30
RESEARCH_QUERIES_PER_CLAIM=3
SOURCE_MAX_BYTES=2000000
# Media (no fixed duration cap)
MAX_CONCURRENT_ANALYSES=1
MEDIA_PROCESSING_CONCURRENCY=1
MEDIA_MAX_SIZE_MB=0
MEDIA_TEMP_DIR=./data/tmp
# Optional network-sandboxed social downloads; requires make setup-social
SOCIAL_DOWNLOAD_ENABLED=false
MEDIA_DOWNLOAD_TIMEOUT=300
# Reports
REPORT_OUTPUT_DIR=./data/reports
PDF_ENABLED=true
# Frontend (public, no credentials)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Hardware
RESOURCE_PROFILE=apple_silicon_8gb
